// Cloudflare Workers 배포 설정 — 견해 犬解 반려견 AI 건강 분석 컨셉 사이트 (pet.demion.co)
// demion-web과 같은 저장소를 쓰는 Worker. 정적 파일만 내보낸다.
// 배포 명령: npx wrangler deploy -c wrangler.pet.jsonc
{
  "name": "pet-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./sites/gyeonhae"
  },
  "routes": [
    { "pattern": "pet.demion.co", "custom_domain": true }
  ]
}
