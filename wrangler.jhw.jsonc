// Cloudflare Workers 배포 설정 — 조각가 조희욱 사이트 (jhw.demion.co)
// demion-web과 같은 저장소를 쓰는 두 번째 Worker. 정적 파일만 내보낸다.
// Cloudflare 대시보드 Workers Builds의 배포 명령: npx wrangler deploy -c wrangler.jhw.jsonc
{
  "name": "jhw-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./sites/choheeuk"
  },
  "routes": [
    { "pattern": "jhw.demion.co", "custom_domain": true }
  ]
}
